# ─────────────────────────────────────────────────────────────────────────────
# SimpleLecture — Apache config for the production SPA build.
# This file is copied verbatim into dist/.htaccess by `vite build`.
#
# Requirements on the server:
#   * mod_rewrite enabled
#   * mod_headers enabled
#   * mod_deflate enabled (recommended)
#   * mod_ssl enabled (the sitemap proxy calls an https:// upstream)
#   * mod_proxy and mod_proxy_http enabled (sitemap proxy)
#   * SSLProxyEngine On in the vhost (sitemap proxy, see below)
#   * AllowOverride All on the document root
#   * mod_alias enabled (ErrorDocument)
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes +SymLinksIfOwnerMatch

# ── SPA fallback ────────────────────────────────────────────────────────────
# 1. If a real file or directory exists at the requested path, serve it.
#    This is what makes our prerendered /<route>/index.html files win over the
#    SPA shell — they're real files on disk after `npm run build:seo`.
# 2. Known SPA routes (allowlist below) get /index.html with HTTP 200.
# 3. Anything else that is not a real file/dir gets a real HTTP 404 (soft-404 fix).
RewriteEngine On

# ── Host canonicalization ───────────────────────────────────────────────────
# Redirect www → apex and http → https with 301.
# NOTE: the https redirect uses %{HTTPS}. If the site sits behind a
# TLS-terminating proxy/load balancer that does not forward HTTPS to Apache,
# this rule will loop forever. In that case set the proxy to send
# X-Forwarded-Proto and add `RewriteCond %{HTTP:X-Forwarded-Proto} !https`
# (or handle the redirect in the vhost instead).
RewriteCond %{HTTP_HOST} ^www\.simplelecture\.com$ [NC]
RewriteRule ^(.*)$ https://simplelecture.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://simplelecture.com/$1 [R=301,L]

# ── Trailing slash normalization ────────────────────────────────────────────
# /blog/ → /blog (301). Root "/" is left alone.
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── Sitemap proxy ───────────────────────────────────────────────────────────
# /sitemap.xml is generated by the Supabase edge function `dynamic-sitemap`.
# Proxy it so Google reads the sitemap from our own domain.
# Requires, in the vhost (not in this file):
#   * mod_proxy, mod_proxy_http and mod_ssl loaded
#   * SSLProxyEngine On  (the upstream is https://)
# Must stay above the SPA fallback below.
RewriteRule ^sitemap\.xml$ https://oxwhqvsoelqqsblmqkxx.supabase.co/functions/v1/dynamic-sitemap [P,L]

# If the URL matches a directory that has an index.html (our prerendered
# routes), rewrite to that file so Apache serves it.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# /learn/:slug landing pages: only the slugs in src/lib/seo/landingPages.ts exist.
# Any other /learn/ slug gets a real 404 status (the SPA would return 200 with
# the homepage <meta robots>). Keep this list in sync with landingPages.ts.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/learn/
RewriteCond %{REQUEST_URI} !^/learn/(jee-main-online-coaching|neet-2026-online-coaching|class-12-physics-online-classes|class-11-physics-online-classes|physics-online-classes|online-coaching-india)(/|$|%|\?) [NC]
RewriteRule . - [R=404,L]

# Unknown paths: real file/dir missing AND not a known SPA route → 404.
# Allowlist = top-level first segments of every route in src/App.tsx.
# Keep this in sync when adding routes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(programs|course|subject|explore|learn|blog|about|success-stories|how-it-works|support|contact|terms|privacy|forum|auth|forgot-password|dashboard|student-dashboard|admin|instructor|checker|my-courses|my-rewards|my-tests|my-notes|practice-results|profile|cart|checkout|payment-success|payment-failed|payment-callback|learning|watch|live|recordings|doubt|enroll|timetable|implementation|ai-tutorial|language-topup|v3-player|v3-trial|v4-player|v5-player|aiteacher|aiteacher-1-to-1|reels|invention-disclosure|tools)?(/|$|%|\?) [NC]
RewriteRule . - [R=404,L]

# Otherwise (allowlisted SPA route, or "/"), serve the SPA shell with 200.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ── Error pages ─────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Caching ────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Hashed assets — bust automatically on every build, safe to cache forever.
  <FilesMatch "\.(js|css|woff2?|jpe?g|png|webp|svg|avif|ico|gif|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — never cache so deploys roll out instantly.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>

  # robots.txt + sitemap — short cache, can be updated independently.
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Proxied sitemap content type. Best-effort fallback only: mod_proxy passes
  # through the upstream response, so the vhost should also set this
  # (e.g. a Header directive in the SSL vhost) to be authoritative.
  Header always set Content-Type "application/xml; charset=utf-8" "expr=%{REQUEST_URI} =~ m#^/sitemap\.xml$#"

  # Security headers.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
  # TODO (follow-up): add a Content-Security-Policy. Not added here because a
  # wrong policy would break the app (inline scripts, Supabase, video/CDN hosts).
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# ── Block hidden files and VCS metadata ─────────────────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<DirectoryMatch "/\.(git|svn|hg)(/|$)">
  Require all denied
</DirectoryMatch>
# Re-allow .well-known/ which some tools need (Let's Encrypt etc.)
<DirectoryMatch "/\.well-known/">
  Require all granted
</DirectoryMatch>

# ── MIME types Apache sometimes misses ──────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .mjs
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
</IfModule>
